{
  "name": "learning-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "tsx scripts/generate-content.ts",
    "check:content": "tsx scripts/validate-content.ts",
    "predev": "pnpm generate",
    "dev": "next dev",
    "prebuild": "pnpm generate && pnpm check:content",
    "build": "next build",
    "start": "next start",
    "types:check": "pnpm generate && next typegen && tsc --noEmit",
    "lint": "eslint",
    "verify": "pnpm generate && pnpm check:content && pnpm test && pnpm types:check && pnpm lint && pnpm build",
    "test": "tsx --test tests/*.test.ts",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "import:ai-interview": "tsx scripts/vendor-github-repo.ts && pnpm generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@mdx-js/mdx": "3.1.1",
